@using FairPlay.Models.Enums
@using FairPlay.Services
@model FairPlay.ViewModels.LlaveViewModel
@{
    var t = Model.Torneo;
    ViewData["Title"] = "Llave - " + t.Nombre;
}

<a asp-controller="Torneos" asp-action="Details" asp-route-id="@t.Codigo" class="fp-back">&larr; @t.Nombre</a>

<div class="fp-page-head">
    <div>
        <div class="fp-eyebrow">Eliminatoria</div>
        <h1>Llave</h1>
        <div class="fp-code-chip mt-2">@t.Nombre · <code>@t.Codigo</code></div>
    </div>
    <a asp-controller="Partidos" asp-action="Index" asp-route-codigoTorneo="@t.Codigo" class="btn btn-outline-secondary">Ver todos los partidos</a>
</div>

@if (Model.Campeon is not null)
{
    <div class="fp-champion">
        <span aria-hidden="true">🏆</span>
        <span>Campeón: @Model.Campeon.Nombre</span>
    </div>
}

@if (Model.Rondas.Count == 0)
{
    <div class="fp-empty">
        <div class="fp-empty__ball" aria-hidden="true"></div>
        <p class="mb-0">Este torneo todavía no tiene eliminatoria. La llave se genera cuando el organizador inicia el torneo.</p>
    </div>
}
else
{
    @* Las rondas van una al lado de la otra (con desplazamiento horizontal en pantallas pequeñas). *@
    <div class="fp-bracket">
        @foreach (var ronda in Model.Rondas.OrderBy(r => r.Numero))
        {
            <div class="fp-bracket__round">
                <h2>@ronda.Nombre</h2>

                @foreach (var c in ronda.Cruces.OrderBy(c => c.Posicion))
                {
                    var nombreA = c.EquipoA?.Nombre ?? "Por definir";
                    var nombreB = c.EquipoB?.Nombre ?? "Por definir";

                    // Bye: el equipo A no tiene rival en este cruce y avanza solo.
                    bool pasaDirecto = c.IdEquipoA.HasValue && !c.IdEquipoB.HasValue && c.IdGanador.HasValue;

                    var partidos = c.Partidos.OrderBy(p => p.NumeroPartido).ToList();
                    var global = ReglasEliminatoria.Global(c, partidos);

                    // Un partido por "Ida"/"Vuelta" si hay dos; "Partido" si hay uno solo.
                    bool dosPartidos = partidos.Count > 1;

                    <div class="fp-tie">
                        @if (pasaDirecto)
                        {
                            <div class="fp-tie__team"><span>@nombreA</span></div>
                            <div class="small text-muted">Pasa directo a la siguiente ronda</div>
                        }
                        else
                        {
                            <div class="fp-tie__team @(c.IdGanador.HasValue && c.IdGanador == c.IdEquipoA ? "fp-tie__team--win" : string.Empty)"><span>@nombreA</span></div>
                            <div class="fp-tie__team @(c.IdGanador.HasValue && c.IdGanador == c.IdEquipoB ? "fp-tie__team--win" : string.Empty)"><span>@nombreB</span></div>
                        }

                        @foreach (var p in partidos)
                        {
                            var local = p.IdLocal == c.IdEquipoA ? nombreA : nombreB;
                            var visitante = p.IdLocal == c.IdEquipoA ? nombreB : nombreA;
                            var etiqueta = dosPartidos ? (p.NumeroPartido == 1 ? "Ida" : "Vuelta") : "Partido";

                            <div class="fp-tie__leg">
                                <span class="fp-tie__leg-label">@etiqueta</span>
                                <span>@local <strong class="fp-num">@ReglasPartido.Marcador(p)</strong> @visitante</span>
                                @if (p.PenalesLocal.HasValue)
                                {
                                    <span class="text-muted">@ReglasEliminatoria.TextoPenales(p)</span>
                                }
                                <partial name="_EstadoPartidoBadge" model="p.Estado" />
                                <a class="fp-icon-link ms-auto" asp-controller="Partidos" asp-action="Details" asp-route-codigoTorneo="@t.Codigo" asp-route-idPartido="@p.IdPartido">Ver</a>
                            </div>
                        }

                        @if (dosPartidos && partidos.Any(p => p.GolesLocal.HasValue))
                        {
                            <div class="small text-muted mt-2 fp-num">Global: @nombreA @global.GolesA - @global.GolesB @nombreB</div>
                        }

                        @if (c.Ganador is not null && !pasaDirecto)
                        {
                            <div class="fp-tie__foot">
                                @(c.IdCruceSiguiente is null ? "Campeón" : "Avanza"): @c.Ganador.Nombre
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}
