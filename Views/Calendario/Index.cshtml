@using System.Globalization
@using FairPlay.Models.Enums
@model FairPlay.ViewModels.GestionCalendarioViewModel
@{
    var t = Model.Torneo;
    ViewData["Title"] = "Calendario - " + t.Nombre;

    // En un torneo finalizado las jornadas ya no se editan.
    bool editable = t.Estado != EstadoTorneo.Finalizado;
}

<a asp-controller="Torneos" asp-action="Details" asp-route-id="@t.Codigo" class="fp-back">&larr; @t.Nombre</a>

<div class="fp-page-head">
    <div>
        <div class="fp-eyebrow">Organizador</div>
        <h1>Gestionar calendario</h1>
        <div class="fp-code-chip mt-2">@t.Nombre · <code>@t.Codigo</code></div>
    </div>

    <div class="fp-actions">
        <a asp-controller="Partidos" asp-action="Index" asp-route-codigoTorneo="@t.Codigo" class="btn btn-outline-secondary">Ver partidos</a>

        @if (t.Formato == FormatoTorneo.Copa)
        {
            <a asp-controller="Eliminatoria" asp-action="Llave" asp-route-codigoTorneo="@t.Codigo" class="btn btn-outline-secondary">Ver llave</a>
        }

        @if (Model.PuedeRegenerar)
        {
            <a asp-action="Preparar" asp-route-codigoTorneo="@t.Codigo" class="btn btn-outline-danger">Regenerar calendario</a>
        }
    </div>
</div>

@if (!Model.PuedeRegenerar && Model.MotivoNoRegenerar is not null)
{
    <div class="alert alert-warning">@Model.MotivoNoRegenerar</div>
}

@if (Model.Rondas.Count == 0)
{
    <div class="fp-empty">
        <div class="fp-empty__ball" aria-hidden="true"></div>
        <p class="mb-0">Este torneo todavía no tiene calendario. Se genera al iniciar el torneo.</p>
    </div>
}
else
{
    <p class="text-muted">
        Puedes cambiar el nombre de cada @(t.Formato == FormatoTorneo.Copa ? "ronda" : "jornada") y ponerle una fecha de inicio (opcional).
        La fecha y la hora de cada partido se fijan en el detalle del partido.
    </p>

    @foreach (var r in Model.Rondas)
    {
        var fechaInput = r.FechaInicio?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty;
        var resumen = $"{r.Partidos} partido(s)" + (r.Descansos > 0 ? $" · {r.Descansos} descanso(s)" : string.Empty);

        @if (editable)
        {
            <form asp-action="EditarRonda" asp-route-codigoTorneo="@t.Codigo" asp-route-idRonda="@r.IdRonda" method="post" class="fp-round">
                <div>
                    <label for="nombre-@r.IdRonda" class="form-label">Nombre</label>
                    <input type="text" id="nombre-@r.IdRonda" name="Nombre" value="@r.Nombre" maxlength="60" class="form-control" required />
                </div>
                <div>
                    <label for="fecha-@r.IdRonda" class="form-label">Fecha de inicio</label>
                    <input type="date" id="fecha-@r.IdRonda" name="FechaInicio" value="@fechaInput" class="form-control" />
                </div>
                <div class="fp-round__info">@resumen</div>
                <div>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        }
        else
        {
            <div class="fp-round fp-round--readonly">
                <strong>@r.Nombre</strong>
                <span class="text-muted small fp-num">
                    @(r.FechaInicio?.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture) ?? "sin fecha") · @resumen
                </span>
            </div>
        }
    }
}
