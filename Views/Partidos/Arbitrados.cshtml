@using FairPlay.Services
@model List<FairPlay.Models.Partido>
@{
    ViewData["Title"] = "Mis partidos";
}

<div class="fp-page-head">
    <div>
        <div class="fp-eyebrow">Árbitro</div>
        <h1>Mis partidos</h1>
        <p class="text-muted mb-0 mt-2">Partidos en los que el organizador te designó como árbitro. Primero los que se están jugando.</p>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="fp-empty">
        <div class="fp-empty__ball" aria-hidden="true"></div>
        <p class="mb-0">Todavía no te designaron como árbitro de ningún partido.</p>
    </div>
}
else
{
    <div class="fp-table-wrap">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Torneo</th>
                    <th>Ronda</th>
                    <th>Partido</th>
                    <th>Fecha y hora</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var torneo = ReglasPartido.TorneoDe(p);

                    <tr>
                        <td class="fw-semibold">@torneo.Nombre</td>
                        <td>@p.Ronda?.Nombre</td>
                        <td>@p.Local?.Nombre <strong class="fp-num mx-1">@ReglasPartido.Marcador(p)</strong> @p.Visitante?.Nombre</td>
                        <td class="fp-num text-nowrap">@(p.FechaHora?.ToString("dd/MM/yyyy HH:mm") ?? "Por definir")</td>
                        <td><partial name="_EstadoPartidoBadge" model="p.Estado" /></td>
                        <td class="fp-td-actions">
                            <a asp-action="Details" asp-route-codigoTorneo="@torneo.Codigo" asp-route-idPartido="@p.IdPartido" class="btn btn-sm btn-primary">Abrir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
