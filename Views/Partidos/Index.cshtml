@using FairPlay.Services
@model FairPlay.ViewModels.PartidosTorneoViewModel
@{
    var t = Model.Torneo;
    ViewData["Title"] = "Partidos - " + t.Nombre;
}

<a asp-controller="Torneos" asp-action="Details" asp-route-id="@t.Codigo" class="fp-back">&larr; @t.Nombre</a>

<div class="fp-page-head">
    <div>
        <div class="fp-eyebrow">Calendario</div>
        <h1>Partidos</h1>
        <div class="fp-code-chip mt-2">@t.Nombre · <code>@t.Codigo</code></div>
    </div>
</div>

@if (Model.Partidos.Count == 0)
{
    <div class="fp-empty">
        <div class="fp-empty__ball" aria-hidden="true"></div>
        <p class="mb-0">Este torneo todavía no tiene partidos programados.</p>
    </div>
}

@* Se agrupa por el id de la ronda (y no por el objeto Ronda) porque cada partido trae su propia copia de la ronda. *@
@foreach (var ronda in Model.Partidos.GroupBy(p => p.IdRonda))
{
    var r = ronda.First().Ronda!;
    var titulo = $"{r.Fase?.Nombre} · {r.Nombre}" + (r.Grupo is null ? string.Empty : $" · {r.Grupo.Nombre}");

    <section class="fp-fixture">
        <h2 class="fp-fixture__title">@titulo</h2>

        <div class="fp-table-wrap">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th class="text-end">Local</th>
                        <th class="text-center">Marcador</th>
                        <th>Visitante</th>
                        <th>Fecha y hora</th>
                        <th>Estado</th>
                        <th>Árbitro</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in ronda)
                    {
                        <tr>
                            <td class="text-end fw-semibold">@p.Local?.Nombre</td>
                            <td class="fp-score">
                                @ReglasPartido.Marcador(p)
                                @if (p.PenalesLocal.HasValue)
                                {
                                    <small>@ReglasEliminatoria.TextoPenales(p)</small>
                                }
                                @if (p.IdCruce.HasValue && p.NumeroPartido == 2)
                                {
                                    <small>Vuelta</small>
                                }
                            </td>
                            <td class="fw-semibold">@(p.EsDescanso ? "—" : p.Visitante?.Nombre)</td>
                            <td class="fp-num text-nowrap">@(p.FechaHora?.ToString("dd/MM/yyyy HH:mm") ?? "Por definir")</td>
                            <td>
                                @if (!p.EsDescanso)
                                {
                                    <partial name="_EstadoPartidoBadge" model="p.Estado" />
                                }
                            </td>
                            <td>@(p.Arbitro?.NombreUsuario ?? "—")</td>
                            <td class="fp-td-actions">
                                @if (!p.EsDescanso)
                                {
                                    <a class="fp-icon-link" asp-action="Details" asp-route-codigoTorneo="@t.Codigo" asp-route-idPartido="@p.IdPartido">Ver</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
