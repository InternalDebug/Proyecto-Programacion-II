@model List<FairPlay.Models.Torneo>
@{
    ViewData["Title"] = "Mis torneos";
}

<h1 class="h3 mb-3">Mis torneos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear torneo</a>
    <a asp-action="Buscar" class="btn btn-outline-secondary">Buscar por código</a>
</p>

@if (Model.Count == 0)
{
    <p class="text-muted">Todavía no has creado ningún torneo.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Formato</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var torneo in Model)
            {
                <tr>
                    <td><code>@torneo.Codigo</code></td>
                    <td>@torneo.Nombre</td>
                    <td>@Html.DisplayFor(m => torneo.Formato)</td>
                    <td>@Html.DisplayFor(m => torneo.Estado)</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@torneo.Codigo">Ver</a> |
                        <a asp-action="Edit" asp-route-id="@torneo.Codigo">Editar</a> |
                        <a asp-action="Delete" asp-route-id="@torneo.Codigo">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
