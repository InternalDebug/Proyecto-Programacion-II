@model List<FairPlay.Models.Torneo>
@{
    ViewData["Title"] = "Mis torneos";
}

<div class="fp-page-head">
    <div>
        <div class="fp-eyebrow">Organizador</div>
        <h1>Mis torneos</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Buscar" class="btn btn-outline-secondary">Buscar por código</a>
        <a asp-action="Create" class="btn btn-primary">Crear torneo</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="fp-empty">
        <div class="fp-empty__ball" aria-hidden="true"></div>
        <p class="mb-3">Todavía no has creado ningún torneo.</p>
        <a asp-action="Create" class="btn btn-primary">Crear mi primer torneo</a>
    </div>
}
else
{
    <div class="fp-tournaments">
        @foreach (var torneo in Model)
        {
            <article class="fp-match">
                <span class="fp-match__code">@torneo.Codigo</span>

                <div>
                    <a class="fp-match__name" asp-action="Details" asp-route-id="@torneo.Codigo">@torneo.Nombre</a>
                    <div class="fp-match__meta">
                        <span class="fp-badge fp-badge--formato">@Html.DisplayFor(m => torneo.Formato)</span>
                        <partial name="_EstadoBadge" model="torneo.Estado" />
                    </div>
                </div>

                <div class="fp-match__actions">
                    <a class="fp-icon-link" asp-action="Details" asp-route-id="@torneo.Codigo">Ver</a>
                    <a class="fp-icon-link" asp-action="Edit" asp-route-id="@torneo.Codigo">Editar</a>
                    <a class="fp-icon-link fp-icon-link--danger" asp-action="Delete" asp-route-id="@torneo.Codigo">Eliminar</a>
                </div>
            </article>
        }
    </div>
}
