@model FairPlay.ViewModels.BuscarTorneoViewModel
@{
    ViewData["Title"] = "Buscar torneo";
}

<section class="fp-search">
    <div class="fp-eyebrow">Encuentra tu torneo</div>
    <h1>Buscar por código</h1>
    <p class="text-muted mb-4">Introduce el código de 8 caracteres que te compartió el organizador.</p>

    @* GET: el código viaja en la URL (/Torneos/Buscar?codigo=ABCD2345), así el enlace se puede compartir *@
    <form asp-action="Buscar" method="get" class="fp-card text-start">
        <div class="mb-3">
            <label asp-for="Codigo" class="form-label"></label>
            <input asp-for="Codigo" name="codigo" class="form-control fp-code-input" autocomplete="off"
                   maxlength="8" placeholder="ABCD2345" autofocus />
            <span asp-validation-for="Codigo" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Buscar</button>
    </form>
</section>
