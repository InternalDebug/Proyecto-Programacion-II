@model FairPlay.ViewModels.TorneoFormViewModel
@{
    ViewData["Title"] = "Editar torneo";
}

<div class="fp-page-head">
    <div>
        <div class="fp-eyebrow">Editar</div>
        <h1>Editar torneo</h1>
        <div class="fp-code-chip mt-2">Código <code>@Model.Codigo</code> · no se puede cambiar</div>
    </div>
</div>

@* asp-route-id lleva el código en la URL; el controlador usa ESE valor, no un campo del formulario *@
<form asp-action="Edit" asp-route-id="@Model.Codigo" method="post" class="fp-card fp-card--form">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <partial name="_CamposTorneo" model="Model" />

    <div class="d-flex align-items-center gap-2 mt-4 pt-3" style="border-top: 1px solid var(--fp-line);">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-action="Details" asp-route-id="@Model.Codigo" class="btn btn-link">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
