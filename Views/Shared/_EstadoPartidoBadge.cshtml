@* Insignia de estado de un partido. Recibe un EstadoPartido. (Para el estado del torneo existe _EstadoBadge.) *@
@using FairPlay.Models.Enums
@using FairPlay.Services
@model EstadoPartido
@{
    var clase = Model switch
    {
        EstadoPartido.EnVivo => "envivo",
        EstadoPartido.Finalizado => "finalizado",
        EstadoPartido.Suspendido => "suspendido",
        _ => "programado"
    };
}
<span class="fp-badge fp-badge--@clase">@ReglasPartido.NombreEstado(Model)</span>
