@* Campos de un jugador. Se comparte entre:
   - Jugadores/Create y Jugadores/Edit  -> <partial name="_CamposJugador" model="Model" />
   - Equipos/Create (primer jugador)    -> <partial name="_CamposJugador" for="PrimerJugador" />
   El "for" conserva el prefijo "PrimerJugador." en los nombres de los campos. *@
@using FairPlay.Models.Enums
@model FairPlay.ViewModels.JugadorFormViewModel

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Apellido" class="form-label"></label>
        <input asp-for="Apellido" class="form-control" />
        <span asp-validation-for="Apellido" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="FechaNacimiento" class="form-label"></label>
    <input asp-for="FechaNacimiento" class="form-control" type="date" />
    <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Posicion" class="form-label"></label>
        <select asp-for="Posicion" asp-items="Html.GetEnumSelectList<PosicionJugador>()" class="form-select"></select>
        <span asp-validation-for="Posicion" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Dorsal" class="form-label"></label>
        <input asp-for="Dorsal" class="form-control" />
        <div class="form-text">Entre 1 y 99. No se puede repetir dentro del equipo.</div>
        <span asp-validation-for="Dorsal" class="text-danger"></span>
    </div>
</div>

<div class="form-check mb-3">
    <input asp-for="EsCapitan" class="form-check-input" />
    <label asp-for="EsCapitan" class="form-check-label"></label>
    <div class="form-text">Un equipo tiene un solo capitán: si marcas esta casilla, el capitán anterior dejará de serlo.</div>
</div>
