@{
    // Controlador y acción actuales: sirven para marcar como activo el enlace de la barra
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var accion = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    string Activo(bool condicion) => condicion ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FairPlay</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FairPlay.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md fp-nav">
            <div class="container">
                <a class="navbar-brand fp-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="fp-brand__mark" aria-hidden="true"></span>FairPlay
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navPrincipal"
                        aria-controls="navPrincipal" aria-expanded="false" aria-label="Mostrar u ocultar el menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navPrincipal">
                    <ul class="navbar-nav me-auto gap-md-1 mt-3 mt-md-0">
                        <li class="nav-item">
                            <a class="nav-link @Activo(controlador == "Home" && accion == "Index")" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Activo(controlador == "Torneos" && accion == "Buscar")" asp-controller="Torneos" asp-action="Buscar">Buscar torneo</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Activo(controlador == "Torneos" && accion != "Buscar")" asp-controller="Torneos" asp-action="Index">Mis torneos</a>
                            </li>
                            @* "Solicitudes de inscripción": solo aparece si el usuario organiza torneos con aprobación *@
                            @await Component.InvokeAsync("SolicitudesNav")
                            @* "Mis partidos": solo aparece si el usuario es árbitro designado en algún partido *@
                            @await Component.InvokeAsync("PartidosNav")
                        }
                    </ul>

                    @* Zona de cuenta: cambia según haya o no sesión iniciada *@
                    <ul class="navbar-nav align-items-md-center gap-md-2 mt-2 mt-md-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link fp-user @Activo(controlador == "Cuenta" && accion == "Perfil")" asp-controller="Cuenta" asp-action="Perfil">
                                    <strong>@User.Identity.Name</strong>
                                </a>
                            </li>
                            <li class="nav-item">
                                @* Cerrar sesión es un POST con token antiforgery (lo agrega el form automáticamente) *@
                                <form asp-controller="Cuenta" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @Activo(controlador == "Cuenta" && accion == "Login")" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-controller="Cuenta" asp-action="Registro">Crear cuenta</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="container-main pb-3">
            @* Mensaje temporal (TempData) que dejan los controladores, por ejemplo tras registrarse *@
            @if (TempData["Mensaje"] is string mensaje)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @mensaje
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }

            @* Mensaje de error temporal (TempData), por ejemplo si no se pudo eliminar un torneo *@
            @if (TempData["Error"] is string mensajeError)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @mensajeError
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="fp-footer">
        <div class="container d-flex justify-content-between">
            <span>&copy; 2026 · FairPlay</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
