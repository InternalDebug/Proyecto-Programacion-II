@* Enlace "Mis partidos" de la barra de navegación (lo dibuja PartidosNavViewComponent) *@
@model FairPlay.Services.ResumenArbitraje

<li class="nav-item">
    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Arbitrados" ? "active" : "")" asp-controller="Partidos" asp-action="Arbitrados">
        Mis partidos
        @if (Model.EnVivo > 0)
        {
            <span class="fp-count fp-count--live" title="En vivo">@Model.EnVivo</span>
        }
        @if (Model.PorJugar > 0)
        {
            <span class="fp-count" title="Programados">@Model.PorJugar</span>
        }
    </a>
</li>
