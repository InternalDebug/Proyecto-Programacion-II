@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="fp-empty mx-auto" style="max-width: 560px;">
    <div class="fp-empty__ball" aria-hidden="true"></div>
    <div class="fp-eyebrow">Fuera de juego</div>
    <h1 class="h3">Ocurrió un error</h1>
    <p>No pudimos procesar tu solicitud. Inténtalo de nuevo en unos instantes.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small">ID de solicitud: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
</div>
