@using FairPlay.Models.Enums
@model FairPlay.ViewModels.EquipoDetalleViewModel
@{
    var equipo = Model.Equipo;
    var torneo = equipo.Torneo!;
    ViewData["Title"] = equipo.Nombre;

    // Los jugadores se ordenan por dorsal
    var jugadores = equipo.Jugadores.OrderBy(j => j.Dorsal).ToList();

    // El torneo finalizado ya no admite cambios en los planteles
    bool torneoFinalizado = torneo.Estado == EstadoTorneo.Finalizado;
}

<a asp-controller="Torneos" asp-action="Details" asp-route-id="@torneo.Codigo" class="fp-back">&larr; @torneo.Nombre</a>

<section class="fp-hero-head">
    <div class="d-flex flex-wrap align-items-center gap-3">
        <img src="@Url.UrlEscudo(equipo.LogoEscudo)" alt="Escudo de @equipo.Nombre" class="fp-crest fp-crest--lg" />
        <div>
            <div class="fp-eyebrow">Equipo</div>
            <h1 class="mb-1">@equipo.Nombre</h1>
            <div class="fp-hero-head__meta text-muted">
                <span>@(string.IsNullOrWhiteSpace(equipo.Ciudad) ? "Sin ciudad" : equipo.Ciudad)</span>
                <span>·</span>
                <partial name="_InscripcionBadge" model="equipo.EstadoInscripcion" />
                <span>·</span>
                <span>Responsable: <strong class="text-body">@equipo.Responsable?.NombreUsuario</strong></span>
            </div>
        </div>
    </div>

    @if (Model.PuedeGestionar)
    {
        <div class="fp-actions">
            <a asp-action="Edit" asp-route-codigoTorneo="@torneo.Codigo" asp-route-idEquipo="@equipo.IdEquipo" class="btn btn-primary">Editar equipo</a>
            <a asp-action="Delete" asp-route-codigoTorneo="@torneo.Codigo" asp-route-idEquipo="@equipo.IdEquipo" class="btn btn-outline-danger">Eliminar equipo</a>
        </div>
    }
</section>

@* El organizador decide las solicitudes desde su ventana "Solicitudes" *@
@if (Model.EsOrganizador && equipo.EstadoInscripcion != EstadoInscripcion.Aprobado)
{
    <div class="alert alert-warning">
        Este equipo está <strong>@Html.DisplayFor(m => m.Equipo.EstadoInscripcion)</strong>.
        Puedes aprobarlo, rechazarlo o eliminarlo en
        <a asp-controller="Solicitudes" asp-action="Index">Solicitudes</a>.
    </div>
}
else if (Model.EsResponsable && equipo.EstadoInscripcion == EstadoInscripcion.Pendiente)
{
    <div class="alert alert-info">Tu solicitud está pendiente: el organizador del torneo debe aprobarla.</div>
}
else if (Model.EsResponsable && equipo.EstadoInscripcion == EstadoInscripcion.Rechazado)
{
    <div class="alert alert-danger">El organizador rechazó la inscripción de este equipo.</div>
}

<section class="fp-block mt-4">
    <div class="fp-block__head">
        <h2>Jugadores <span class="fp-count fp-count--plain">@jugadores.Count</span></h2>

        @if (Model.PuedeGestionar && !torneoFinalizado)
        {
            <a asp-controller="Jugadores" asp-action="Create" asp-route-codigoTorneo="@torneo.Codigo" asp-route-idEquipo="@equipo.IdEquipo" class="btn btn-primary btn-sm">Agregar jugador</a>
        }
    </div>

    @if (jugadores.Count == 0)
    {
        <div class="fp-empty">
            <div class="fp-empty__ball" aria-hidden="true"></div>
            <p class="mb-0">Este equipo todavía no tiene jugadores.</p>
        </div>
    }
    else
    {
        <div class="fp-table-wrap">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th class="text-end" style="width: 80px;">Dorsal</th>
                        <th>Jugador</th>
                        <th>Posición</th>
                        <th>Nacimiento</th>
                        <th>Capitán</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var j in jugadores)
                    {
                        <tr>
                            <td class="text-end fw-bold fp-num">@j.Dorsal</td>
                            <td class="fw-semibold">@j.NombreCompleto</td>
                            <td>@Html.DisplayFor(m => j.Posicion)</td>
                            <td class="fp-num">@j.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                            <td>@if (j.EsCapitan) { <span class="fp-badge fp-badge--aprobado">Capitán</span> }</td>
                            <td class="fp-td-actions">
                                @if (Model.PuedeGestionar && !torneoFinalizado)
                                {
                                    <div class="fp-actions">
                                        <a class="fp-icon-link" asp-controller="Jugadores" asp-action="Edit" asp-route-codigoTorneo="@torneo.Codigo" asp-route-idEquipo="@equipo.IdEquipo" asp-route-idJugador="@j.IdJugador">Editar</a>
                                        <a class="fp-icon-link fp-icon-link--danger" asp-controller="Jugadores" asp-action="Delete" asp-route-codigoTorneo="@torneo.Codigo" asp-route-idEquipo="@equipo.IdEquipo" asp-route-idJugador="@j.IdJugador">Eliminar</a>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
