@model FairPlay.ViewModels.EquipoFormViewModel
@{
    ViewData["Title"] = "Editar equipo";
}

<a asp-action="Details" asp-route-codigoTorneo="@Model.CodigoTorneo" asp-route-idEquipo="@Model.IdEquipo" class="fp-back">&larr; Volver al equipo</a>

<div class="fp-page-head">
    <div>
        <div class="fp-eyebrow">Editar</div>
        <h1>Editar equipo</h1>
    </div>
</div>

<form asp-controller="Equipos" asp-action="Edit" asp-route-codigoTorneo="@Model.CodigoTorneo" asp-route-idEquipo="@Model.IdEquipo" method="post" enctype="multipart/form-data" class="fp-card fp-card--form">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @* Solo sirve para volver a mostrar el escudo si el formulario se vuelve a dibujar con errores *@
    <input type="hidden" asp-for="EscudoActual" />

    @if (!string.IsNullOrEmpty(Model.EscudoActual))
    {
        <div class="d-flex align-items-center gap-3 mb-4">
            <img src="@Url.UrlEscudo(Model.EscudoActual)" alt="Escudo actual" class="fp-crest fp-crest--lg" />
            <div>
                <div class="form-label mb-1">Escudo actual</div>
                <div class="form-check">
                    <input asp-for="QuitarEscudo" class="form-check-input" />
                    <label asp-for="QuitarEscudo" class="form-check-label"></label>
                </div>
            </div>
        </div>
    }

    <partial name="_CamposEquipo" model="Model" />

    <div class="fp-form-actions">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-action="Details" asp-route-codigoTorneo="@Model.CodigoTorneo" asp-route-idEquipo="@Model.IdEquipo" class="btn btn-link">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
