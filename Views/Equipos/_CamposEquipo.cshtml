@* Campos del equipo compartidos por Create (inscripción) y Edit. *@
@model FairPlay.ViewModels.EquipoFormViewModel

<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Ciudad" class="form-label"></label>
    <input asp-for="Ciudad" class="form-control" />
    <div class="form-text">Opcional.</div>
    <span asp-validation-for="Ciudad" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Escudo" class="form-label"></label>
    <input asp-for="Escudo" type="file" class="form-control" accept="image/png,image/jpeg,image/webp" />
    <div class="form-text">Opcional. PNG, JPG o WEBP, máximo 2 MB. Si no subes ninguno se mostrará un icono por defecto.</div>
    <span asp-validation-for="Escudo" class="text-danger"></span>
</div>
