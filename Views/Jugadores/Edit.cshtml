@model FairPlay.ViewModels.JugadorFormViewModel
@{
    ViewData["Title"] = "Editar jugador";
}

<a asp-controller="Equipos" asp-action="Details" asp-route-codigoTorneo="@Model.CodigoTorneo" asp-route-idEquipo="@Model.IdEquipo" class="fp-back">&larr; Volver al equipo</a>

<div class="fp-page-head">
    <div>
        <div class="fp-eyebrow">@(string.IsNullOrEmpty(Model.NombreEquipo) ? "Editar" : Model.NombreEquipo)</div>
        <h1>Editar jugador</h1>
    </div>
</div>

<form asp-controller="Jugadores" asp-action="Edit" asp-route-codigoTorneo="@Model.CodigoTorneo" asp-route-idEquipo="@Model.IdEquipo" asp-route-idJugador="@Model.IdJugador" method="post" class="fp-card fp-card--form">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <partial name="_CamposJugador" model="Model" />

    <div class="fp-form-actions">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-controller="Equipos" asp-action="Details" asp-route-codigoTorneo="@Model.CodigoTorneo" asp-route-idEquipo="@Model.IdEquipo" class="btn btn-link">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
