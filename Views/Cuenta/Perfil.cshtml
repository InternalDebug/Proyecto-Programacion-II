@model FairPlay.Models.Usuario
@{
    ViewData["Title"] = "Mi perfil";
}

<div class="fp-card fp-card--form">
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="fp-avatar" aria-hidden="true">@(Model.NombreUsuario.Length > 0 ? Model.NombreUsuario.Substring(0, 1) : "?")</div>
        <div>
            <div class="fp-eyebrow mb-0">Mi perfil</div>
            <h1 class="h3 mb-0">@Model.NombreUsuario</h1>
        </div>
    </div>

    <dl class="fp-facts">
        <div class="fp-fact">
            <dt>Usuario</dt>
            <dd>@Model.NombreUsuario</dd>
        </div>
        <div class="fp-fact">
            <dt>Correo</dt>
            <dd>@Model.Email</dd>
        </div>
        <div class="fp-fact">
            <dt>Miembro desde</dt>
            <dd>@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm") (UTC)</dd>
        </div>
    </dl>
</div>

@* Nota: nunca mostramos PasswordHash. *@
